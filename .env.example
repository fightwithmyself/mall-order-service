# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=mall_order

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=your_password

# 业务参数（可选）
# 未支付自动关单秒数，默认 1800（30 分钟）；调试时可改成 30
# 注意：修改后需要在 RabbitMQ 管理台删除 order_timeout_queue 队列再重启服务，否则参数冲突
# ORDER_TIMEOUT_SECONDS=1800
# RATE_LIMIT_CREATE_ORDER=10
# RATE_LIMIT_WINDOW=60
